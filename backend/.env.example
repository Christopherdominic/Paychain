DATABASE_URL="postgresql://paychain:paychain123@localhost:5432/paychain"
JWT_SECRET="your-super-secret-jwt-key-change-this"
PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Interswitch Configuration
ISW_CLIENT_ID="your_client_id_here"
ISW_CLIENT_SECRET="your_client_secret_here"
ISW_BASE_URL="https://qa.interswitchng.com"
ISW_OAUTH_BASE_URL="https://passport-v2.k8.isw.la"
ISW_OAUTH_SCOPE="profile"
ISW_BVN_ENDPOINT="/api/v1/identity/bvn"
